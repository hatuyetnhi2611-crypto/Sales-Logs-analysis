WITH calc_2017 AS (
    SELECT 
        "Order Item Id",
        "Sales"::numeric AS sales_val,
        (
            ABS(CASE WHEN "Order Profit Per Order"::numeric < 0 THEN "Order Profit Per Order"::numeric ELSE 0 END)
            + "Order Item Total"::numeric
        ) AS implied_costs
    FROM "DataCo"
    WHERE UPPER("Order Status") IN ('COMPLETE', 'CLOSED')
      AND EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2017
),
base_orders AS (
    SELECT 
        "Order Item Id",
        (implied_costs - sales_val) AS cost_diff,
        CASE 
            WHEN (implied_costs / NULLIF(sales_val, 0)) <= 1.15 THEN '<= 1.15'
            WHEN (implied_costs / NULLIF(sales_val, 0)) <= 1.5  THEN '<= 1.5'
            WHEN (implied_costs / NULLIF(sales_val, 0)) <= 2.0  THEN '<= 2'
            WHEN (implied_costs / NULLIF(sales_val, 0)) <= 2.5  THEN '<= 2.5'
            ELSE '> 2.5'
        END AS ratio_group
    FROM calc_2017
    WHERE implied_costs > sales_val
),
grouped_metrics AS (
    SELECT 
        ratio_group,
        COUNT("Order Item Id") AS order_item_count,
        SUM(cost_diff) AS total_cost_diff
    FROM base_orders
    GROUP BY ratio_group
)
SELECT 
    ratio_group,
    order_item_count,
    ROUND(total_cost_diff::numeric, 2) AS total_cost_diff,
    ROUND((order_item_count::numeric / NULLIF(SUM(order_item_count) OVER (), 0)) * 100, 2) AS pct_of_total_count,
    ROUND((total_cost_diff::numeric / NULLIF(SUM(total_cost_diff) OVER (), 0)) * 100, 2) AS pct_of_total_cost_diff
FROM grouped_metrics
ORDER BY 
    CASE ratio_group
        WHEN '<= 1.15' THEN 1
        WHEN '<= 1.5'  THEN 2
        WHEN '<= 2'    THEN 3
        WHEN '<= 2.5'  THEN 4
        ELSE 5
    END;
