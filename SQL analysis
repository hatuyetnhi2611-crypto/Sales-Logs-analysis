--Checking logic validation
SELECT *
FROM "DataCo"
WHERE
  "Days for shipping (real)" < 0
  OR "Days for shipment (scheduled)" < 0
  OR TO_TIMESTAMP("shipping date (DateOrders)", 'MM/DD/YYYY HH24:MI') 
  < TO_TIMESTAMP("order date (DateOrders)", 'MM/DD/YYYY HH24:MI')
  OR (
      "Delivery Status" = 'Advance shipping' 
      AND "Days for shipping (real)" > "Days for shipment (scheduled)"
     )
  OR (
      "Delivery Status" = 'Late delivery' 
      AND "Days for shipping (real)" < "Days for shipment (scheduled)"
     )
  OR (
        "Delivery Status" = 'Shipping on time' 
        AND "Days for shipping (real)" <> "Days for shipment (scheduled)"
    );
