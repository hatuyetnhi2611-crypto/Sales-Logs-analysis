--High revenue concentration

WITH yearly_product_sales AS (
    SELECT 
        "Product Name",
        SUM(CASE WHEN EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2015 THEN "Order Item Total" ELSE 0 END) AS total_2015,
        SUM(CASE WHEN EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2016 THEN "Order Item Total" ELSE 0 END) AS total_2016,
        SUM(CASE WHEN EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2017 THEN "Order Item Total" ELSE 0 END) AS total_2017
    FROM "DataCo"
    WHERE UPPER("Order Status") IN ('COMPLETE', 'CLOSED')
      AND EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) IN (2015, 2016, 2017)
    GROUP BY "Product Name"
),
summed_totals AS (
    SELECT 
        SUM(total_2015) AS grand_total_2015,
        SUM(total_2016) AS grand_total_2016,
        SUM(total_2017) AS grand_total_2017
    FROM yearly_product_sales
),
ranked_sales AS (
    SELECT 
        yps."Product Name",
        ROUND(yps.total_2015::numeric, 2) AS total_2015,
        ROUND(yps.total_2016::numeric, 2) AS total_2016,
        ROUND(yps.total_2017::numeric, 2) AS total_2017,
        -- Tính tổng lũy kế (running total) theo từng năm giảm dần để tính cumulative percentage chính xác
        SUM(yps.total_2015) OVER (ORDER BY yps.total_2015 DESC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_total_2015,
        SUM(yps.total_2016) OVER (ORDER BY yps.total_2016 DESC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_total_2016,
        SUM(yps.total_2017) OVER (ORDER BY yps.total_2017 DESC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_total_2017
    FROM yearly_product_sales yps
)
SELECT 
    rs."Product Name",
    rs.total_2015,
    rs.total_2016,
    rs.total_2017,
    ROUND(((rs.running_total_2015 / NULLIF(st.grand_total_2015, 0)) * 100)::numeric, 2) AS cum_pct_2015,
    ROUND(((rs.running_total_2016 / NULLIF(st.grand_total_2016, 0)) * 100)::numeric, 2) AS cum_pct_2016,
    ROUND(((rs.running_total_2017 / NULLIF(st.grand_total_2017, 0)) * 100)::numeric, 2) AS cum_pct_2017
FROM ranked_sales rs
CROSS JOIN summed_totals st
ORDER BY rs.total_2017 DESC;

