--Dataset overview
--Checking dataset structure

SELECT 
    COUNT(*) AS total_rows,
    (SELECT count(*) FROM information_schema.columns WHERE table_name = 'DataCo') AS total_columns
FROM "DataCo";

--Checking columns' name in the dataset

SELECT * FROM "DataCo";

--Checking distinct values of order status, delivery status, type, and shipping mode

SELECT DISTINCT "Shipping Mode" FROM "DataCo";

SELECT DISTINCT "Order Status" FROM "DataCo";

SELECT DISTINCT "Delivery Status" FROM "DataCo";

SELECT DISTINCT "Type" FROM "DataCo";

--Find max & min values of order item product price, order item discount rate, order date (DateOrders), and shipping date (DateOrders)

SELECT
    MIN("Order Item Product Price") AS min_product_price,
    MAX("Order Item Product Price") AS max_product_price,
    MIN("Order Item Discount Rate") AS min_discount_rate,
    MAX("Order Item Discount Rate") AS max_discount_rate,
    MIN("order date (DateOrders)"::timestamp) AS earliest_order_date,
    MAX("order date (DateOrders)"::timestamp) AS latest_order_date,
    MIN("shipping date (DateOrders)"::timestamp) AS earliest_shipping_date,
    MAX("shipping date (DateOrders)"::timestamp) AS latest_shipping_date
FROM "DataCo";

--Data cleaning
--Find duplicate
SELECT *
FROM "DataCo"
WHERE "Order Item Id" IN (
    SELECT "Order Item Id"
    FROM "DataCo"
    GROUP BY "Order Item Id"
    HAVING COUNT(*) > 1
)
ORDER BY "Order Item Id";

