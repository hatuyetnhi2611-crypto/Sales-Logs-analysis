-- Breakdown of realized revenue by markets and products.

WITH product_market_sales AS (
    SELECT 
        "Product Name",
        MAX("Product Price") AS product_price,
        -- Doanh thu 2016 theo 5 market
        SUM(CASE WHEN EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2016 AND "Market" = 'LATAM' THEN "Order Item Total" ELSE 0 END) AS latam_2016,
        SUM(CASE WHEN EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2016 AND "Market" = 'Pacific Asia' THEN "Order Item Total" ELSE 0 END) AS pacific_asia_2016,
        SUM(CASE WHEN EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2016 AND "Market" = 'USCA' THEN "Order Item Total" ELSE 0 END) AS usca_2016,
        SUM(CASE WHEN EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2016 AND "Market" = 'Africa' THEN "Order Item Total" ELSE 0 END) AS africa_2016,
        SUM(CASE WHEN EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2016 AND "Market" = 'Europe' THEN "Order Item Total" ELSE 0 END) AS europe_2016,
        -- Doanh thu 2017 theo 5 market
        SUM(CASE WHEN EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2017 AND "Market" = 'LATAM' THEN "Order Item Total" ELSE 0 END) AS latam_2017,
        SUM(CASE WHEN EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2017 AND "Market" = 'Pacific Asia' THEN "Order Item Total" ELSE 0 END) AS pacific_asia_2017,
        SUM(CASE WHEN EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2017 AND "Market" = 'USCA' THEN "Order Item Total" ELSE 0 END) AS usca_2017,
        SUM(CASE WHEN EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2017 AND "Market" = 'Africa' THEN "Order Item Total" ELSE 0 END) AS africa_2017,
        SUM(CASE WHEN EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2017 AND "Market" = 'Europe' THEN "Order Item Total" ELSE 0 END) AS europe_2017,
        -- Tổng doanh thu toàn bộ 5 market trong năm 2017 để làm mẫu số tính cum_pct
        SUM(CASE WHEN EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2017 AND "Market" IN ('LATAM', 'Pacific Asia', 'USCA', 'Africa', 'Europe') THEN "Order Item Total" ELSE 0 END) AS total_2017_all
    FROM "DataCo"
    WHERE UPPER("Order Status") IN ('COMPLETE', 'CLOSED')
      AND EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) IN (2016, 2017)
    GROUP BY "Product Name"
),
running_totals AS (
    SELECT 
        pms.*,
        SUM(latam_2017) OVER (ORDER BY latam_2017 DESC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS run_latam,
        SUM(pacific_asia_2017) OVER (ORDER BY pacific_asia_2017 DESC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS run_pacific,
        SUM(usca_2017) OVER (ORDER BY usca_2017 DESC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS run_usca,
        SUM(africa_2017) OVER (ORDER BY africa_2017 DESC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS run_africa,
        SUM(europe_2017) OVER (ORDER BY europe_2017 DESC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS run_europe,
        
        -- Tổng doanh thu riêng của từng market trong năm 2017 để tính phần trăm lũy kế chính xác cho từng cột market đó
        SUM(latam_2017) OVER () as sum_latam_all,
        SUM(pacific_asia_2017) OVER () as sum_pacific_all,
        SUM(usca_2017) OVER () as sum_usca_all,
        SUM(africa_2017) OVER () as sum_africa_all,
        SUM(europe_2017) OVER () as sum_europe_2017_all
    FROM product_market_sales pms
)
SELECT 
    rt."Product Name",
    rt.product_price,
    -- 2016 Data (5 columns)
    ROUND(rt.latam_2016::numeric, 2) AS latam_2016,
    ROUND(rt.pacific_asia_2016::numeric, 2) AS pacific_asia_2016,
    ROUND(rt.usca_2016::numeric, 2) AS usca_2016,
    ROUND(rt.africa_2016::numeric, 2) AS africa_2016,
    ROUND(rt.europe_2016::numeric, 2) AS europe_2016,
    -- 2017 Data (5 columns)
    ROUND(rt.latam_2017::numeric, 2) AS latam_2017,
    ROUND(rt.pacific_asia_2017::numeric, 2) AS pacific_asia_2017,
    ROUND(rt.usca_2017::numeric, 2) AS usca_2017,
    ROUND(rt.africa_2017::numeric, 2) AS africa_2017,
    ROUND(rt.europe_2017::numeric, 2) AS europe_2017,
    -- Cumulative Percentage per Market (5 columns)
    ROUND(((rt.run_latam / NULLIF(rt.sum_latam_all, 0)) * 100)::numeric, 2) AS cum_pct_latam_2017,
    ROUND(((rt.run_pacific / NULLIF(rt.sum_pacific_all, 0)) * 100)::numeric, 2) AS cum_pct_pacific_2017,
    ROUND(((rt.run_usca / NULLIF(rt.sum_usca_all, 0)) * 100)::numeric, 2) AS cum_pct_usca_2017,
    ROUND(((rt.run_africa / NULLIF(rt.sum_africa_all, 0)) * 100)::numeric, 2) AS cum_pct_africa_2017,
    ROUND(((rt.run_europe / NULLIF(rt.sum_europe_2017_all, 0)) * 100)::numeric, 2) AS cum_pct_europe_2017
FROM running_totals rt
ORDER BY europe_2017 DESC;

-- Average revenue per unit of each markets.

WITH market_yearly AS (
    SELECT 
        "Market",
        -- 2016 metrics
        SUM(CASE WHEN EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2016 THEN "Order Item Quantity" ELSE 0 END) AS qty_2016,
        SUM(CASE WHEN EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2016 THEN "Order Item Total" ELSE 0 END) AS rev_2016,
        -- 2017 metrics
        SUM(CASE WHEN EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2017 THEN "Order Item Quantity" ELSE 0 END) AS qty_2017,
        SUM(CASE WHEN EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2017 THEN "Order Item Total" ELSE 0 END) AS rev_2017
    FROM "DataCo"
    WHERE UPPER("Order Status") IN ('COMPLETE', 'CLOSED')
      AND EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) IN (2016, 2017)
    GROUP BY "Market"
)
SELECT 
    "Market",
    -- 2016 (Quantity, Revenue, ARPU)
    qty_2016 AS qty_2016,
    ROUND(rev_2016::numeric, 2) AS revenue_2016,
    ROUND((rev_2016::numeric / NULLIF(qty_2016, 0)), 2) AS arpu_2016,
    -- 2017 (Quantity, Revenue, ARPU)
    qty_2017 AS qty_2017,
    ROUND(rev_2017::numeric, 2) AS revenue_2017,
    ROUND((rev_2017::numeric / NULLIF(qty_2017, 0)), 2) AS arpu_2017
FROM market_yearly
ORDER BY revenue_2017 DESC;

--Profit situation
--Profitability & margin insights

SELECT 
    EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) AS order_year,
    ROUND(SUM("Order Item Total")::numeric, 2) AS total_order_item_total,
    ROUND(SUM("Order Profit Per Order")::numeric, 2) AS total_profit,
    ROUND(SUM(CASE WHEN "Order Profit Per Order" < 0 THEN "Order Profit Per Order" ELSE 0 END)::numeric, 2) AS total_loss,
    ROUND((SUM("Order Profit Per Order") / NULLIF(SUM("Order Item Total"), 0))::numeric, 4) AS profit_margin,
    ROUND((SUM(CASE WHEN "Order Profit Per Order" > 0 THEN "Order Profit Per Order" ELSE 0 END) / NULLIF(SUM("Order Item Total"), 0))::numeric, 4) AS positive_profit_share_of_revenue,
    ROUND((ABS(SUM(CASE WHEN "Order Profit Per Order" < 0 THEN "Order Profit Per Order" ELSE 0 END)) / NULLIF(SUM("Order Item Total"), 0))::numeric, 4) AS loss_share_of_revenue
FROM "DataCo"
WHERE UPPER("Order Status") IN ('COMPLETE', 'CLOSED')
  AND EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) IN (2015, 2016, 2017)
GROUP BY order_year
ORDER BY order_year;

-- Loss patterns & exposure reporting

SELECT 
    EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) AS order_year,
    ROUND(SUM("Order Profit Per Order")::numeric, 2) AS total_profit,
    ROUND(SUM(CASE WHEN "Order Profit Per Order" < 0 THEN "Order Profit Per Order" ELSE 0 END)::numeric, 2) AS total_loss
FROM "DataCo"
WHERE UPPER("Order Status") IN ('COMPLETE', 'CLOSED')
  AND EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) IN (2015, 2016, 2017)
GROUP BY order_year
ORDER BY order_year;

WITH product_loss_2017 AS (
    SELECT 
        "Product Name",
        ROUND(ABS(SUM(CASE WHEN "Order Profit Per Order" < 0 THEN "Order Profit Per Order" ELSE 0 END))::numeric, 2) AS abs_total_loss,
        ROUND(SUM("Sales")::numeric, 2) AS total_gross_revenue
    FROM "DataCo"
    WHERE UPPER("Order Status") IN ('COMPLETE', 'CLOSED')
      AND EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2017
    GROUP BY "Product Name"
    HAVING SUM(CASE WHEN "Order Profit Per Order" < 0 THEN "Order Profit Per Order" ELSE 0 END) < 0
),
total_company_loss AS (
    SELECT SUM(abs_total_loss) AS grand_total_loss FROM product_loss_2017
),
ranked_losses AS (
    SELECT 
        pl."Product Name",
        pl.abs_total_loss,
        pl.total_gross_revenue,
        SUM(pl.abs_total_loss) OVER (ORDER BY pl.abs_total_loss DESC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_loss
    FROM product_loss_2017 pl
)
SELECT 
    rl."Product Name",
    rl.abs_total_loss,
    rl.total_gross_revenue,
    ROUND(((rl.running_loss / NULLIF(t.grand_total_loss, 0)) * 100)::numeric, 2) AS cumulative_pct_loss,
    ROUND((rl.abs_total_loss / NULLIF(rl.total_gross_revenue, 0))::numeric, 4) AS loss_ratio
FROM ranked_losses rl
CROSS JOIN total_company_loss t
ORDER BY rl.abs_total_loss DESC;

-- Target areas for financial loss mitigation
-- Discount.
-- Total loss amount generated by discounted orders and the discounted amount

SELECT 
    ROUND(SUM("Order Item Discount"::numeric), 2) AS total_order_item_discount,
    ROUND(SUM("Order Profit Per Order"::numeric), 2) AS total_profit_per_order
FROM "DataCo"
WHERE UPPER("Order Status") IN ('COMPLETE', 'CLOSED')
  AND EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2017
  AND "Order Item Discount"::numeric > 0
  AND "Order Profit Per Order"::numeric < 0;

-- Comparison of products with greatest loss before and after removing discount.

WITH product_loss_2017 AS (
    SELECT 
        "Product Name",
        ABS(SUM(CASE WHEN "Order Profit Per Order"::numeric < 0 THEN "Order Profit Per Order"::numeric ELSE 0 END)) AS abs_total_loss
    FROM "DataCo"
    WHERE UPPER("Order Status") IN ('COMPLETE', 'CLOSED')
      AND EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2017
    GROUP BY "Product Name"
    HAVING SUM(CASE WHEN "Order Profit Per Order"::numeric < 0 THEN "Order Profit Per Order"::numeric ELSE 0 END) < 0
),
top_10_products AS (
    SELECT "Product Name"
    FROM product_loss_2017
    ORDER BY abs_total_loss DESC
    LIMIT 10
),
filtered_orders AS (
    SELECT 
        d."Product Name",
        d."Order Profit Per Order"::numeric AS profit_val,
        d."Order Item Discount"::numeric AS discount_val
    FROM "DataCo" d
    INNER JOIN top_10_products t ON d."Product Name" = t."Product Name"
    WHERE UPPER(d."Order Status") IN ('COMPLETE', 'CLOSED')
      AND EXTRACT(YEAR FROM d."order date (DateOrders)"::timestamp) = 2017
      AND d."Order Profit Per Order"::numeric < 0
      AND d."Order Item Discount"::numeric > 0
),
aggregated_top10 AS (
    SELECT 
        t."Product Name",
        ABS(COALESCE(SUM(f.profit_val), 0)) AS loss_before_removing_discount,
        COALESCE(SUM(f.discount_val), 0) AS total_order_item_discount
    FROM top_10_products t
    LEFT JOIN filtered_orders f ON t."Product Name" = f."Product Name"
    GROUP BY t."Product Name"
)
SELECT 
    a."Product Name",
    ROUND(a.loss_before_removing_discount::numeric, 2) AS loss_before_removing_discount,
    ROUND(a.total_order_item_discount::numeric, 2) AS total_order_item_discount,
    ROUND((a.loss_before_removing_discount - a.total_order_item_discount)::numeric, 2) AS loss_after_removing_discount
FROM aggregated_top10 a
JOIN product_loss_2017 p ON a."Product Name" = p."Product Name"
ORDER BY p.abs_total_loss DESC;

-- Implied costs.
-- Summary about implied costs in 2017

WITH loss_orders_2017 AS (
    SELECT 
        "Order Item Id",
        "Sales"::numeric AS sales_val,
        (
            ABS(CASE WHEN "Order Profit Per Order"::numeric < 0 THEN "Order Profit Per Order"::numeric ELSE 0 END)
            + "Order Item Total"::numeric
        ) AS implied_costs
    FROM "DataCo"
    WHERE UPPER("Order Status") IN ('COMPLETE', 'CLOSED')
      AND "Order Profit Per Order"::numeric < 0
      AND EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2017
)
SELECT 
    COUNT("Order Item Id") AS total_order_item_count,
    COUNT(
        CASE 
            WHEN sales_val < implied_costs 
            THEN "Order Item Id" 
        END
    ) AS sales_below_implied_costs_count,
    ROUND(
        MIN(
            CASE 
                WHEN implied_costs > sales_val 
                THEN implied_costs / NULLIF(sales_val, 0) 
            END
        )::numeric, 
        4
    ) AS min_implied_cost_to_sales_ratio,
    ROUND(
        MAX(
            CASE 
                WHEN implied_costs > sales_val 
                THEN implied_costs / NULLIF(sales_val, 0) 
            END
        )::numeric, 
        4
    ) AS max_implied_cost_to_sales_ratio
FROM loss_orders_2017;

-- Test the association between delivery status and cost to sales ratio.
WITH calc_2017 AS (
    SELECT 
        "Delivery Status",
        "Sales"::numeric AS sales_val,
        (
            ABS(CASE WHEN "Order Profit Per Order"::numeric < 0 THEN "Order Profit Per Order"::numeric ELSE 0 END)
            + "Order Item Total"::numeric
        ) AS implied_costs
    FROM "DataCo"
    WHERE UPPER("Order Status") IN ('COMPLETE', 'CLOSED')
      AND EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2017
)
SELECT 
    "Delivery Status",
    ROUND(SUM(implied_costs - sales_val)::numeric, 2) AS cost_minus_sales,
    ROUND(SUM(sales_val)::numeric, 2) AS total_sales,
    ROUND((SUM(implied_costs - sales_val) / NULLIF(SUM(sales_val), 0))::numeric, 4) AS excess_cost_to_sales_ratio
FROM calc_2017
WHERE implied_costs > sales_val
GROUP BY "Delivery Status"
ORDER BY cost_minus_sales DESC;

-- Test the association between product price and cost to sales ratio.

WITH calc_2017 AS (
    SELECT 
        "Order Item Id",
        "Product Price"::numeric AS price_val,
        "Sales"::numeric AS sales_val,
        (
            ABS(CASE WHEN "Order Profit Per Order"::numeric < 0 THEN "Order Profit Per Order"::numeric ELSE 0 END)
            + "Order Item Total"::numeric
        ) AS implied_costs
    FROM "DataCo"
    WHERE UPPER("Order Status") IN ('COMPLETE', 'CLOSED')
      AND EXTRACT(YEAR FROM "order date (DateOrders)"::timestamp) = 2017
),
base_orders AS (
    SELECT 
        "Order Item Id",
        price_val,
        CASE 
            WHEN (implied_costs / NULLIF(sales_val, 0)) <= 1.15 THEN '<= 1.15'
            WHEN (implied_costs / NULLIF(sales_val, 0)) <= 1.5  THEN '<= 1.5'
            WHEN (implied_costs / NULLIF(sales_val, 0)) <= 2.0  THEN '<= 2'
            WHEN (implied_costs / NULLIF(sales_val, 0)) <= 2.5  THEN '<= 2.5'
            ELSE '> 2.5'
        END AS ratio_group
    FROM calc_2017
    WHERE implied_costs > sales_val
),
grouped_counts AS (
    SELECT 
        ratio_group,
        COUNT(CASE WHEN price_val <= 60 THEN "Order Item Id" END) AS cnt_price_le_60,
        COUNT(CASE WHEN price_val > 60 AND price_val <= 200 THEN "Order Item Id" END) AS cnt_price_le_200,
        COUNT(CASE WHEN price_val > 200 AND price_val <= 500 THEN "Order Item Id" END) AS cnt_price_le_500,
        COUNT(CASE WHEN price_val > 500 AND price_val <= 1000 THEN "Order Item Id" END) AS cnt_price_le_1000,
        COUNT(CASE WHEN price_val > 1000 THEN "Order Item Id" END) AS cnt_price_gt_1000
    FROM base_orders
    GROUP BY ratio_group
)
SELECT 
    ratio_group,
    ROUND((cnt_price_le_60::numeric / NULLIF(SUM(cnt_price_le_60) OVER (), 0)) * 100, 2) AS price_less_or_equal_60,
    ROUND((cnt_price_le_200::numeric / NULLIF(SUM(cnt_price_le_200) OVER (), 0)) * 100, 2) AS price_less_or_equal_200,
    ROUND((cnt_price_le_500::numeric / NULLIF(SUM(cnt_price_le_500) OVER (), 0)) * 100, 2) AS price_less_or_equal_500,
    ROUND((cnt_price_le_1000::numeric / NULLIF(SUM(cnt_price_le_1000) OVER (), 0)) * 100, 2) AS price_less_or_equal_1000,
    ROUND((cnt_price_gt_1000::numeric / NULLIF(SUM(cnt_price_gt_1000) OVER (), 0)) * 100, 2) AS price_over_1000
FROM grouped_counts
ORDER BY 
    CASE ratio_group
        WHEN '<= 1.15' THEN 1
        WHEN '<= 1.5'  THEN 2
        WHEN '<= 2'    THEN 3
        WHEN '<= 2.5'  THEN 4
        ELSE 5
    END;

